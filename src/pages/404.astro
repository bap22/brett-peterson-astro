---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="wrap pt-12">
    <p class="font-mono text-sm text-royal">HTTP/2 404</p>
    <h1 class="mt-4 text-[clamp(4rem,13vw,11rem)] font-black uppercase">Not here</h1>
    <p class="measure mt-6 text-lg">That page moved or never existed. Old blog links redirect automatically, so if you followed one, the post may have been retired. Try <a class="underline" href="/writing">Writing</a>, or press <kbd class="border border-rule px-1 font-mono text-sm">⌘K</kbd> to search.</p>
  </section>
</Base>
