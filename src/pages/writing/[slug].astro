---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
  return posts.map((post, i) => ({ params: { slug: post.id }, props: { post, newer: posts[i - 1], older: posts[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(post.data.date);
---
<Base title={post.data.title} description={post.data.summary}>
  <article class="wrap pt-12" data-x="<article>">
    <a href="/writing" class="link text-sm text-slate">Writing</a>
    <h1 class="mt-6 max-w-[14ch] text-[clamp(3rem,8vw,6.5rem)] font-black">{post.data.title}</h1>
    <p class="mt-6 text-sm text-slate"><time datetime={post.data.date.toISOString()}>{date}</time>{post.data.tags.length > 0 && <>, filed under {post.data.tags.join(', ')}</>}</p>
    <div class="prose prose-lg mt-12 max-w-[38em] prose-headings:font-display prose-a:text-royal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-none prose-pre:bg-ink prose-pre:text-snow">
      <Content />
    </div>
    {post.data.condensed && <p class="mt-10 max-w-[38em] border-l-2 border-hi pl-4 text-sm text-slate">Condensed from the original post on my WordPress blog.</p>}
    <nav class="mt-20 grid gap-6 border-t border-rule pt-6 sm:grid-cols-2" aria-label="More posts">
      {older ? <a href={`/writing/${older.id}`} class="no-underline"><span class="text-sm text-slate">Older</span><span class="block font-medium hover:text-royal">{older.data.title}</span></a> : <span></span>}
      {newer && <a href={`/writing/${newer.id}`} class="no-underline sm:text-right"><span class="text-sm text-slate">Newer</span><span class="block font-medium hover:text-royal">{newer.data.title}</span></a>}
    </nav>
  </article>
</Base>
