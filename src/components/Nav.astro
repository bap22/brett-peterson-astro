---
import Roll from './Roll.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/work', label: 'Work' },
  { href: '/games', label: 'Games' },
  { href: '/writing', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---
<header class="wrap flex items-center justify-between py-5" data-x="<header>" transition:persist>
  <a href="/" class="font-display text-2xl font-black tracking-tight no-underline" aria-label="Brett Peterson, home">bp</a>
  <nav aria-label="Main" class="flex items-center gap-5 text-sm sm:gap-7">
    {links.map((l) => (
      <a href={l.href} class:list={['no-underline', path.startsWith(l.href) && 'font-semibold']} aria-current={path.startsWith(l.href) ? 'page' : undefined}><Roll text={l.label} /></a>
    ))}
    <button type="button" data-xray-toggle class="hidden border border-rule px-2 py-1 text-[13px] hover:border-ink sm:inline" aria-pressed="false" title="Show how this page is built (X)">
      <Roll text="View source" />
    </button>
    <button type="button" data-palette-open class="border border-rule px-2 py-1 font-mono text-[12px] hover:border-ink" aria-label="Open command menu" title="Command menu (⌘K)">⌘K</button>
  </nav>
</header>
