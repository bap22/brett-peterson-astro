---
interface Props { email: string; socials: { label: string; url: string }[] }
const { email, socials } = Astro.props;
---
<footer id="contact" class="mt-32 border-t border-rule" data-x="<footer#contact>">
  <div class="wrap grid gap-10 py-16 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-slate">Have a site that needs to work harder?</p>
      <button type="button" data-copy={email} class="group mt-2 text-left font-display text-[clamp(2.4rem,7vw,6rem)] font-extrabold leading-none tracking-tight" aria-label={`Copy ${email} to clipboard`}>
        <span class="link">{email}</span>
        <span class="mt-3 block font-sans text-sm font-normal tracking-normal text-slate group-hover:text-ink" data-copy-label>Click to copy</span>
      </button>
    </div>
    <ul class="flex flex-wrap gap-6 text-sm">
      {socials.map((s) => <li><a class="link" href={s.url} rel="me noopener" target="_blank">{s.label}</a></li>)}
    </ul>
  </div>
  <div class="wrap flex flex-wrap justify-between gap-4 border-t border-rule py-6 text-sm text-slate">
    <span>© {new Date().getFullYear()} Brett Peterson, Highland, Utah</span>
    <span id="perf-line" data-x="<span#perf-line>">Built with Astro.</span>
  </div>
</footer>
